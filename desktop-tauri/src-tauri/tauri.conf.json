{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daythread",
  "version": "0.24.0",
  "identifier": "online.hugoxk.daythread",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Daythread",
        "width": 1000,
        "height": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
