{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daythread",
  "version": "0.22.0",
  "identifier": "online.hugoxk.daythread",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Daythread",
        "width": 1000,
        "height": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
